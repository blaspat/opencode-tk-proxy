[Unit]
Description=Hermes LLM Proxy with Compression
After=network.target

[Service]
Type=simple
User=patrick
WorkingDirectory=/home/patrick/.hermes/artifacts/claire/opencode-tk-proxy
Environment=VERBOSE=true
Environment=COMPRESS=true
ExecStart=/home/patrick/.hermes/hermes-agent/venv/bin/python3 /home/patrick/.hermes/artifacts/claire/opencode-tk-proxy/proxy.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
